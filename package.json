{
  "name": "drizzle-postgrejs",
  "description": "Drizzle ORM driver for PostgreJS - run a Drizzle schema on PostgreJS's wire-protocol client",
  "version": "1.1.1",
  "author": "Panates",
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "drizzle-orm": ">=0.44.6 <0.46.0",
    "postgrejs": ">=3.11.0 <4"
  },
  "devDependencies": {
    "@panates/eslint-config": "^2.3.5",
    "@panates/eslint-config-ts": "^2.3.5",
    "@panates/rman-preset": "^2.2.2",
    "@panates/tsconfig": "^2.1.8",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@swc/helpers": "^0.5.24",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "c8": "^12.0.0",
    "dpdm": "^4.3.0",
    "drizzle-orm": "^0.45.4",
    "expect": "^30.5.2",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "mocha": "^12.0.3",
    "pg": "^8.23.1",
    "postgrejs": "^3.15.1",
    "typescript": "^6.0.3"
  },
  "scripts": {
    "typecheck": "tsc -b tsconfig-build.json --noEmit",
    "test": "mocha",
    "precitest": "rman clean",
    "citest": "c8 mocha",
    "bench": "node --expose-gc benchmark/drizzle-bench.mjs",
    "bench:report": "node benchmark/render-report.mjs",
    "prepare": "husky || true",
    "prepublishOnly": "echo 'Publish from the build directory - run rman publish, which generates that manifest itself.' && exit 1"
  },
  "type": "module",
  "module": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22.0"
  },
  "homepage": "https://www.postgrejs.com/",
  "contributors": [
    "Eray Hanoglu <e.hanoglu@panates.com>",
    "Ilker Gurelli <i.gurelli@panates.com>",
    "Onur Tokel <o.tokel@panates.com>",
    "Bircan Yuruk <b.yuruk@panates.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/panates/postgrejs-drizzle.git"
  },
  "keywords": [
    "drizzle",
    "drizzle-orm",
    "drizzle-driver",
    "postgrejs",
    "postgresql",
    "postgres",
    "sql",
    "orm",
    "typescript",
    "wire-protocol",
    "no-native-bindings"
  ],
  "publishConfig": {
    "access": "public"
  }
}
